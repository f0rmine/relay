VITE_API_BASE_URL=http://localhost:8000
# Optional. Defaults to VITE_API_BASE_URL with ws:// or wss://.
# VITE_WS_BASE_URL=ws://localhost:8000

# Production/TLS:
# VITE_API_BASE_URL=https://relay.example.com
# VITE_WS_BASE_URL=wss://relay.example.com
# Optional Android build-time shell variable for verified password-reset App Links.
# Export it before ./scripts/android-build.sh; Vite does not load this value.
# CAPACITOR_APP_LINK_HOST=relay.example.com

# Android emulator:
# VITE_API_BASE_URL=http://10.0.2.2:8000
# VITE_WS_BASE_URL=ws://10.0.2.2:8000

# Real phone on the same LAN:
# VITE_API_BASE_URL=http://192.168.1.50:8000
# VITE_WS_BASE_URL=ws://192.168.1.50:8000
